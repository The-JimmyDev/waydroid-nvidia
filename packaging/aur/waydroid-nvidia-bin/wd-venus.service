[Unit]
Description=Venus vtest render server for waydroid-nvidia

[Service]
# Private per-user socket directory (systemd creates $XDG_RUNTIME_DIR/waydroid-venus,
# mode 0700, owned by this unit's user; root can still traverse it to set up the
# container bind-mount). This replaces a shared, root-owned, world-writable
# /run/waydroid-venus: that directory let ANY local user on the machine find and
# connect to this socket directly, not just the intended waydroid container, and a
# process that can connect can drive the GPU through it. The socket file itself is
# still made world-connectable below (arbitrary uids run inside the container), but
# now only a process that can already resolve this path — i.e. one waydroid-nvidia
# bind-mounts into its own container, or root — can even find it.
RuntimeDirectory=waydroid-venus
Environment=RENDER_SERVER_EXEC_PATH=/usr/lib/waydroid-nvidia/virgl_render_server
Environment=LD_LIBRARY_PATH=/usr/lib/waydroid-nvidia
ExecStart=/usr/lib/waydroid-nvidia/virgl_test_server --venus --multi-clients --socket-path %t/waydroid-venus/venus.sock
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
